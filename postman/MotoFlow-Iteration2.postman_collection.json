        {
          "name": "BM xem gợi ý mã dưới ngưỡng",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/replenishment-requests/low-stock-suggestions",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{branchBmToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test('Số gợi ý là phần còn thiếu so với ngưỡng', () => rows.forEach(row => {",
                  "    pm.expect(row.availableQty).to.be.below(row.lowStockThreshold);",
                  "    pm.expect(row.suggestedQty).to.eql(row.lowStockThreshold - row.availableQty);",
                  "}));",
                  "pm.test('Bỏ qua mã đang chờ trong yêu cầu chưa đóng', () => {",
                  "    const waiting = [pm.collectionVariables.get('partId'), pm.collectionVariables.get('secondPartId')].map(Number);",
                  "    rows.forEach(row => pm.expect(waiting).to.not.include(row.productId));",
                  "});"
                ]
              }
            }
          ]
