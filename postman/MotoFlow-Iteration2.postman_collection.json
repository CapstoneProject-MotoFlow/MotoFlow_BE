        {
          "name": "BM tạo yêu cầu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/replenishment-requests",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{branchBmToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Sắp hết hàng\",\n  \"lines\": [\n    { \"productId\": {{partId}}, \"requestedQty\": 5 },\n    { \"productId\": {{secondPartId}}, \"requestedQty\": 2 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('requestId', b.id);",
                  "pm.test('Chờ điều phối, đúng cửa hàng của BM', () => {",
                  "    pm.expect(b.status).to.eql('AWAITING_COORDINATION');",
                  "    pm.expect(b.requestingStoreId).to.eql(Number(pm.collectionVariables.get('branchStoreId')));",
                  "});",
                  "pm.test('Có 2 dòng, chưa điều phối gì', () => {",
                  "    pm.expect(b.lines.length).to.eql(2);",
                  "    pm.expect(b.lines[0].requestedQty).to.eql(5);",
                  "    pm.expect(b.lines[0].plannedQty).to.eql(0);",
                  "    pm.expect(b.lines[0].remainingQty).to.eql(5);",
                  "    pm.expect(b.transferOrders).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        },
